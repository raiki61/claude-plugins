#!/usr/bin/env bash
# works-factory の薄い入口。止めた commit（隣の PIN）の raiki61/works-factory を取り置きに用意し、その殻 bin/works-factory
# （apply なら bin/apply）に引数をそのまま渡す。認証・隔離・Archon の取り寄せは向こうの殻が持つので、ここでは何もしない。
# 使い方: works-factory <Archon の CLI の引数…> ／ works-factory apply <run> --cwd <対象>
set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
pin=$(tr -d '[:space:]' < "$here/PIN")
case "$pin" in
  *[!0-9a-f]*|"") echo "works-factory: PIN が 40 桁の commit でない: $pin" >&2; exit 2 ;;
esac
[ "${#pin}" -eq 40 ] || { echo "works-factory: PIN が 40 桁の commit でない: $pin" >&2; exit 2; }

# 工場は Python 3.12 以上で動く。python3・python・版の付いた名前（python3.20 から python3.12 まで新しい順）・py -3 の順に、
# 実際に起きる 3.12 以上の物を選ぶ（docs/standards/cross-os.md の決まり 1。rent-or-buy の bin/rent-or-buy と同じ作り）。
# PATH の python3 をそのまま使わないのは、macOS 付属の python3 が 3.9 で、uv で入れた python は版の付いた名前でだけ PATH に在り、
# Windows の python3 は Python を入れていないと Microsoft Store へ誘う代わりの物に当たるため。
py=
named='' n=20
while [ "$n" -ge 12 ]; do named="$named python3.$n"; n=$((n - 1)); done
for cand in python3 python $named "py -3"; do
  command -v "${cand%% *}" >/dev/null 2>&1 || continue
  # shellcheck disable=SC2086
  $cand -c 'import sys; sys.exit(sys.version_info < (3, 12))' >/dev/null 2>&1 && { py=$cand; break; }
done
[ -n "$py" ] || { echo "works-factory: python 3.12 以上が見つからない（python3・python・python3.20〜python3.12・py -3 を試した）。python 3.12 以上を入れる（例: brew install python）。入っているのに見つからないときは、入れた場所を PATH に足す" >&2; exit 2; }

repo=${WORKS_FACTORY_PLUGIN_REPO:-https://github.com/raiki61/works-factory.git}
cache=${XDG_CACHE_HOME:-$HOME/.cache}/works-factory-plugin
dir=$cache/$pin

if [ ! -x "$dir/bin/works-factory" ]; then
  command -v git >/dev/null 2>&1 || { echo "works-factory: git が要る" >&2; exit 2; }
  mkdir -p "$cache"
  tmp=$(mktemp -d "$cache/.fetch.XXXXXX")
  trap 'rm -rf "${tmp:?}"' EXIT
  git -C "$tmp" init -q
  git -C "$tmp" fetch -q --depth 1 "$repo" "$pin"
  git -C "$tmp" -c advice.detachedHead=false checkout -q FETCH_HEAD
  [ "$(git -C "$tmp" rev-parse HEAD)" = "$pin" ] || { echo "works-factory: 取った commit が PIN と違う" >&2; exit 2; }
  rm -rf "${dir:?}"
  mv "$tmp" "$dir"
  trap - EXIT
fi

if [ "${1:-}" = apply ]; then
  shift
  # shellcheck disable=SC2086
  exec $py "$dir/bin/apply" "$@"
fi
# shellcheck disable=SC2086
exec $py "$dir/bin/works-factory" "$@"
