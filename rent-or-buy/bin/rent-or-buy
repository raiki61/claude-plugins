#!/bin/sh
''':'
# ここから閉じの引用符 3 つまでは sh が読む（Python には 1 つの文字列）。python3・python・版の付いた名前（python3.20 から python3.11 まで、
# 新しい順）・py -3 の順に、実際に起きる 3.11 以上の物でこの台本を起動し直す。版の付いた名前を試すのは、uv で入れた Python がその名前で
# だけ PATH に在り、PATH の python3 が macOS 付属の 3.9 のことがあるため（docs/standards/cross-os.md の決まり 1）。PATH の頭の python3 をそのまま使わないのは、Windows の python3・python が、Python を入れていないと
# Microsoft Store へ誘う代わりの物（起動すると案内を出して終わる）に当たるため（tiers/bin/tiers と同じ作り）。
named='' n=20
while [ "$n" -ge 11 ]; do named="$named python3.$n"; n=$((n - 1)); done
# shellcheck disable=SC2086
for cand in python3 python $named "py -3"; do
  command -v "${cand%% *}" >/dev/null 2>&1 || continue
  # shellcheck disable=SC2086
  $cand -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1 && exec $cand "$0" "$@"
done
echo "rent-or-buy: no usable Python 3.11+ found (tried python3, python, python3.20 down to python3.11, py -3). Install Python 3.11 or later; if it is installed but not found, add the folder it was installed in to PATH" >&2
exit 1
'''
"""借りるか買うかの判断のコマンド。標準入力に JSON を受け、標準出力に JSON を返す。

  rent-or-buy decide                         中心をそのまま呼ぶ
  rent-or-buy keepalive [--transcript FILE]  keepalive の判断（記録からモデル・文脈・最後の要求の時刻を埋める）
  rent-or-buy compact [--transcript FILE]    compact の判断（記録からモデル・文脈・compact の後の文脈・余分に読んだ累計を埋める）
  rent-or-buy prices MODEL                   揃えた名前と、使う単価と、その出どころ
  rent-or-buy outcome                        判断の鍵（key）に結果の行を足す（同じ鍵の結果が在れば足さない）
  rent-or-buy records [--since T] [--until T] 判断の記録の行を JSON Lines で出す（T は ISO 8601 の日時）
  rent-or-buy snapshot                       LiteLLM の main から同梱の値段の写しを作り直す

終わりのコード: 0 判断できた / 2 入力の形が違う / 3 知らないモデル / 4 記録を読めない（snapshot と、outcome の書けない失敗は 1）。
0 以外でも標準出力に {"error": 鍵, "why": 英語の訳} を返す。環境変数は README の Environment。
設計はプラグインの docs/design.md（英語の正本）と docs/design.ja.md（日本語の訳）。
"""
import argparse
import json
import os
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
import rent_or_buy  # noqa: E402
from prompt_cache import prices, transcript, translate  # noqa: E402


class _Parser(argparse.ArgumentParser):
    def error(self, message):
        _emit({"error": "invalid_input", "why": message})
        sys.exit(2)


def _emit(obj) -> None:
    print(json.dumps(obj, ensure_ascii=False))


def _fail(key: str, why: str, code: int, row=None):
    """失敗を返す。row があれば入力ごと記録に残す（知らないモデル名などを機械で拾えるように）。"""
    out = {"error": key, "why": why}
    if row is not None:
        _record(dict(row, output=out))
    _emit(out)
    return code


def _record_path():
    """判断の記録の置き場。RENT_OR_BUY_RECORD（off なら None）か、キャッシュのフォルダの decisions.jsonl。"""
    target = os.environ.get("RENT_OR_BUY_RECORD")
    if target == "off":
        return None
    return target or prices.cache_dir() / "decisions.jsonl"


def _record(row: dict):
    """判断の記録を足す。書けなければ訳を返す。"""
    path = _record_path()
    if path is None:
        return None
    row = dict(row, ts=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
    return rent_or_buy.append_record(path, row)


def _outcome() -> int:
    """標準入力の結果（1 件の表か {"outcomes": [表, ...]}）を確かめ、まだ結果の無い鍵だけ記録に足す。1 件でも形が違えば何も足さない。"""
    try:
        data = _read_stdin()
        items = data["outcomes"] if set(data) == {"outcomes"} else [data]
        if not isinstance(items, list):
            raise rent_or_buy.InputError("outcomes must be a JSON array")
        items = [rent_or_buy.check_outcome(x) for x in items]
    except rent_or_buy.InputError as e:
        return _fail("invalid_input", str(e), 2)
    path = _record_path()
    if path is None:
        return _fail("record_off", "RENT_OR_BUY_RECORD is off, so outcomes cannot be kept", 2)
    seen = {r.get("input", {}).get("key") for r in rent_or_buy.read_records(path) if r.get("scene") == "outcome"}
    added = 0
    for item in items:
        if item["key"] in seen:
            continue
        err = _record({"scene": "outcome", "input": item})
        if err:
            return _fail("write_failed", err, 1)
        seen.add(item["key"])
        added += 1
    _emit({"recorded": added, "duplicates": len(items) - added})
    return 0


def _records(args) -> int:
    path = _record_path()
    try:
        rows = rent_or_buy.read_records(path, args.since, args.until)
    except rent_or_buy.InputError as e:
        return _fail("invalid_input", str(e), 2)
    for row in rows:
        print(json.dumps(row, ensure_ascii=False, separators=(",", ":")))
    return 0


def _read_stdin() -> dict:
    text = sys.stdin.read()
    try:
        data = json.loads(text) if text.strip() else {}
    except ValueError as e:
        raise rent_or_buy.InputError("standard input is not JSON: %s" % e)
    if not isinstance(data, dict):
        raise rent_or_buy.InputError("standard input must be a JSON object")
    return data


def _from_transcript(scene: str, facts: dict, path: str, override) -> tuple:
    """記録から埋める事実を facts の下に敷く（標準入力の値が勝つ）。返すのは (事実, 記録の読み取りの情報)。"""
    tr = transcript.read(path)
    base = {k: tr[k] for k in ("model", "context_tokens") if k in tr}
    if scene == "keepalive" and "last_request_at" in tr:
        base["last_request_at"] = tr["last_request_at"]
    # この場面に要る事実が記録からも標準入力からも揃わなければ、既定で埋めず止める
    # （compact の直後でまだ応答が無いときなど。文脈の量を compact の後の量で代えることはしない）
    need = ("model", "context_tokens") + (("last_request_at",) if scene == "keepalive" else ())
    lacking = [k for k in need if k not in {**base, **facts}]
    if lacking:
        raise transcript.TranscriptError("the transcript lacks %s needed for %s (no response yet after a compact?)"
                                         % (", ".join(lacking), scene))
    if scene == "compact":
        base.update({k: tr[k] for k in ("after_write_tokens", "after_read_tokens") if k in tr})
        merged = {**base, **facts}
        if "spent" not in merged:
            price = prices.lookup(translate.check_model(merged["model"]), override)
            base["spent"] = translate.extra_read_cost(tr["contexts_after_compact"], translate.after_tokens(merged), price)
    return {**base, **facts}, {"skipped_lines": tr["skipped_lines"]}


def _fail_row(scene: str, facts) -> dict:
    row = {"scene": scene}
    if facts is not None:
        row["input"] = facts
    return row


def _judge(scene: str, args) -> int:
    facts = received = None
    try:
        facts = _read_stdin()
        received = dict(facts)  # prices を取り出す前の写し。記録の input はこれ
        # prices（単価の上書き）を受けるのは keepalive と compact だけ。decide では知らない鍵として止まる
        override = facts.pop("prices", None) if scene != "decide" else None
        info = None
        if scene == "decide":
            out = rent_or_buy.decide(facts)
        else:
            if args.transcript:
                facts, info = _from_transcript(scene, facts, args.transcript, override)
            out = getattr(translate, scene)(facts, override)
            if info is not None:
                out["transcript"] = info
    except (rent_or_buy.InputError, translate.FactsError) as e:
        return _fail("invalid_input", str(e), 2, _fail_row(scene, received))
    except prices.PricesError as e:
        return _fail(e.key, e.why, e.code, _fail_row(scene, received))
    except transcript.TranscriptError as e:
        return _fail("transcript_unreadable", str(e), 4, _fail_row(scene, received))
    row = {"scene": scene, "input": received}
    err = _record(dict(row, output=out))
    if err:
        out["record"] = err
    _emit(out)
    return 0


def main() -> int:
    ap = _Parser(prog="rent-or-buy", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True, parser_class=_Parser)
    sub.add_parser("decide")
    for name in ("keepalive", "compact"):
        sub.add_parser(name).add_argument("--transcript", metavar="FILE")
    sub.add_parser("prices").add_argument("model")
    sub.add_parser("snapshot")
    sub.add_parser("outcome")
    rec = sub.add_parser("records")
    rec.add_argument("--since", metavar="T")
    rec.add_argument("--until", metavar="T")
    args = ap.parse_args()
    if args.cmd == "outcome":
        return _outcome()
    if args.cmd == "records":
        return _records(args)
    try:
        if args.cmd == "prices":
            p = prices.lookup(args.model)
            _emit({"input": args.model, **p.info(), "rates": {k: p.rate(k) for k in prices.FIELDS}, "entry": p.entry})
            return 0
        if args.cmd == "snapshot":
            try:
                snap = prices.fetch_snapshot(time.strftime("%Y-%m-%d", time.gmtime()), timeout=120)
            except (OSError, ValueError, KeyError) as e:
                return _fail("fetch_failed", "could not fetch from LiteLLM: %s" % e, 1)
            try:
                (ROOT / "prompt_cache" / "snapshot.json").write_text(
                    json.dumps(snap, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
            except OSError as e:
                return _fail("write_failed", "could not write the snapshot file: %s" % e, 1)
            _emit({"models": len(snap["models"]), "commit": snap["commit"], "fetched": snap["fetched"]})
            return 0
        return _judge(args.cmd, args)
    except prices.PricesError as e:  # prices サブコマンドの失敗は記録しない（調べ用で、判断ではない）
        return _fail(e.key, e.why, e.code)


if __name__ == "__main__":
    for _s in (sys.stdout, sys.stderr, sys.stdin):
        if hasattr(_s, "reconfigure"):
            _s.reconfigure(encoding="utf-8")
    sys.exit(main())
