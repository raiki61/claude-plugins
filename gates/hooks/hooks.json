{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/coldread-gate.py\"",
            "shell": "bash",
            "timeout": 275,
            "statusMessage": "外部投稿ゲートを確認中"
          },
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/dest-gate.py\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "宛先ゲートを確認中"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/coldread-gate.py\" docs-record",
            "shell": "bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/coldread-gate.py\" docs-record",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/coldread-gate.py\" docs-record",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/coldread-gate.py\" docs-check",
            "shell": "bash",
            "timeout": 900,
            "statusMessage": "coldread: このサブエージェントが書いた文書を初見の読み手が読んでいる"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/coldread-gate.py\" docs-session-end",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/coldread-gate.py\" docs-check",
            "shell": "bash",
            "timeout": 900,
            "statusMessage": "coldread: このターンで書いた文書を初見の読み手が読んでいる"
          },
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"${CLAUDE_PLUGIN_ROOT}/hooks/coldread-gate.py\" docs-check-async",
            "shell": "bash",
            "asyncRewake": true,
            "timeout": 900
          }
        ]
      }
    ]
  }
}
