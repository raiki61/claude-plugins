#!/usr/bin/env bash
# main への push の前に、push する commit で軽い検査（scripts/light-check.sh）を回し、落ちれば push を止める。
# --land を通さない急ぎの直接の push でも、軽い検査を飛ばせないようにするため（2026-10-20、受付 2ee37b。中身は scripts/light-check.sh の頭）。
# 入れ方: git config core.hooksPath .githooks（clone に 1 度。worktree は設定を共有する。--land のゲートの light-check.sh が空なら書く）。
# 同じ tree で緑の印（共通の git の場所の light-check-ok/<tree>）が有れば回し直さない。検査は、push する commit を一時の worktree に出して回す
# （今の作業ツリーが push する commit そのもので、変更が無ければその場で回す）。main 以外のブランチと、ブランチを消す push は見ない。
set -uo pipefail
mark="$(git rev-parse --path-format=absolute --git-common-dir)/light-check-ok"
rc=0
while read -r _lref lsha rref _rsha; do
    [ "$rref" = refs/heads/main ] || continue
    [[ "$lsha" =~ [^0] ]] || continue
    tree=$(git rev-parse "$lsha^{tree}") || { rc=1; continue; }
    [ -e "$mark/$tree" ] && continue
    echo "pre-push: main へ push する ${lsha:0:7} で軽い検査（scripts/light-check.sh）を回す" >&2
    if [ "$(git rev-parse HEAD)" = "$lsha" ] && [ -z "$(git status --porcelain)" ]; then
        bash scripts/light-check.sh </dev/null >&2 || rc=1
    else
        tmp=$(mktemp -d)
        if git worktree add --quiet --detach "$tmp/tree" "$lsha" >&2; then
            bash "$tmp/tree/scripts/light-check.sh" </dev/null >&2 || rc=1
            git worktree remove --force "$tmp/tree" >&2
        else
            rc=1
        fi
        rm -rf "$tmp"
    fi
    [ "$rc" = 0 ] || echo "pre-push: 軽い検査が赤なので main へ push しない（直して commit してから push し直す）" >&2
done
exit "$rc"
