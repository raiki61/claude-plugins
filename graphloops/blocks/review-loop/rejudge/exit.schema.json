 },
 "$defs": {
  "class_query": {
   "type": "object",
   "required": [
    "how",
    "counts",
    "total"
   ],
   "additionalProperties": false,
   "properties": {
    "how": {
     "$ref": "engine#/count_how"
    },
    "counts": {
     "$ref": "../fix/exit.schema.json#/$defs/counts"
    },
    "total": {
     "type": "integer",
     "minimum": 0
    },
    "note": {
     "type": "string"
    }
   },
   "note": "同じ形を全部引ける機械の問い（how）と、数えるものの向き（counts）と、そのとき出た件数（total）。how は直す site になる行を全部数える形で書く——根の 1 行だけを数えると、修正役が塞ぐ site の数が母数を超えて拒まれる。1 site しか無いことの証明も total: 1 で書く。engine が how をこの周に固定した版（判定役が読んだのと同じ版）で走らせ、記録には engine が数えた件数を残す。修正役の修正の後は、同じ how を作業ツリーで数え直す"
  }
 }
}
