{
 "description": "R8 再審 の出口: ほかのブロックの節が読む節（reads・条件の cond_reads・hist の hist_reads・pointers・delegate.result_to で）の出力の型を、節の名前を鍵に並べる。graph の節の schema はここを $ref で指す（正本はここだけ）",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "p2.rejudge": {
   "type": "object",
   "required": [
    "verdict",
    "new_facts",
    "units"
   ],
   "additionalProperties": false,
   "properties": {
    "verdict": {
     "type": "string",
     "enum": [
      "採る",
      "退ける",
      "一部採る"
     ]
    },
    "new_facts": {
     "type": "string",
     "minLength": 20,
     "note": "回す側が出した新しい事実を、自分で確かめた結果。確かめずに採るな・退けるな"
    },
    "reason": {
     "type": "string"
    },
    "units": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "label"
      ],
      "additionalProperties": true,
      "properties": {
       "key": {
        "type": "string",
        "minLength": 1
       },
       "label": {
        "type": "string",
        "enum": [
         "block",
         "suggest",
         "nit",
         "question",
         "info"
        ]
       },
       "disposition": {
        "type": "string",
        "enum": [
         "do-now",
         "defer"
        ]
       },
       "reason": {
        "type": "string"
       },
       "reopen_evidence": {
        "type": "string"
       },
       "origin_analysis": {
        "type": "string"
       },
       "why_chain": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "prescriptions": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "closed_note": {
        "type": "string"
       },
       "class_query": {
        "$ref": "#/$defs/class_query"
       }
      }
     }
    }
   }
  },
  "p2.rejudge_third": {
   "type": "object",
   "required": [
    "verdict",
    "new_facts",
    "units"
   ],
   "additionalProperties": false,
   "properties": {
    "verdict": {
     "type": "string",
     "enum": [
      "採る",
