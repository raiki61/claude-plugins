    },
    "reason": {
     "type": "string"
    },
    "units": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "key",
       "label"
      ],
      "additionalProperties": true,
      "properties": {
       "key": {
        "type": "string",
        "minLength": 1
       },
       "label": {
        "type": "string",
        "enum": [
         "block",
         "suggest",
         "nit",
         "question",
         "info"
        ]
       },
       "disposition": {
        "type": "string",
        "enum": [
         "do-now",
         "defer"
        ]
       },
       "reason": {
        "type": "string"
       },
       "reopen_evidence": {
        "type": "string"
       },
       "origin_analysis": {
        "type": "string"
       },
       "why_chain": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "prescriptions": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "closed_note": {
