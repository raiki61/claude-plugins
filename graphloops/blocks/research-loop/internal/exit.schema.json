{
 "description": "S4 内部の突合 の出口: ほかのブロックの節が読む節（reads・条件の cond_reads・hist の hist_reads・pointers・delegate.result_to で）の出力の型を、節の名前を鍵に並べる。graph の節の schema はここを $ref で指す（正本はここだけ）",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "p5.internal": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "facts",
    "corrections"
   ],
   "properties": {
    "facts": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "constraint_text",
       "verified",
       "actual",
       "location"
      ],
      "properties": {
       "constraint_text": {
        "type": "string"
       },
       "verified": {
        "type": "boolean"
       },
       "actual": {
        "type": "string"
       },
       "location": {
        "type": "string"
       }
      }
     }
    },
    "corrections": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "text"
      ],
      "properties": {
       "text": {
        "type": "string",
        "minLength": 1
       },
       "location": {
        "type": "string"
       }
      }
     }
    }
   }
  }
 }
}
