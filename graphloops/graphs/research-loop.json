    "as": "item",
    "cover": {
     "items_at": "item.claims",
     "key": "id",
     "answers_at": "findings"
    }
   },
   "source": "P4 ＞ 確認ラウンドの抜き取り検査",
   "prompt_file": "../prompts/research-loop/p3.sampling.md",
   "reads": [
    "item.claims"
   ],
   "forbidden_inputs": [
    "元の判定・理由"
   ],
   "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "findings"
    ],
    "properties": {
     "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "id",
        "verdict",
        "evidence",
        "sources"
       ],
       "properties": {
        "id": {
         "type": "string"
        },
        "verdict": {
         "type": "string",
         "enum": [
          "確証",
          "相違",
          "留保",
          "検証不能"
         ]
        },
        "evidence": {
         "type": "string",
         "minLength": 1
        },
        "sources": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "conditions": {
         "type": "string"
        },
        "correction": {
         "type": "string"
        },
        "needs": {
         "type": "string"
        }
       }
      }
     }
    }
   },
   "writes": [
    {
     "op": "sampling_overturn",
     "from": "$"
    }
   ],
   "outputs": [
    "sampling（status・sampled_ids・overturned）"
   ],
   "note": "抜き取りの選定と覆りの数え上げは駆動器（無作為・元の判定との比較）。覆った主張は recheck が付き次の周の P1 へ"
  },
  "converge": {
   "stage": "P4",
   "run_by": "driver",
   "builtin": "converge",
   "deps": [
    "p1.record_check",
    "p2.integrate",
    "p3.rederiver_compare",
    "p3.cartographer_compare",
    "p3.cold_reader",
    "p3.sampling"
   ],
   "source": "P4: 収束判定",
   "outputs": [
    "convergence（rounds_total・consecutive_zero・outcome・stopped_reason）"
   ],
   "verdict_is_copy": true
  },
  "p5.adapt": {
   "stage": "P5",
   "run_by": "surveyor",
   "deps": [
    "converge"
   ],
   "source": "P5: ドメイン適応",
   "prompt_file": "../prompts/research-loop/p5.adapt.md",
   "reads": [
    "record",
    "inputs.document",
    "out.p5.internal"
   ],
   "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "decide_now",
     "poc",
     "human_only"
    ],
    "properties": {
     "decide_now": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "text",
        "basis",
        "premortem",
        "tripwire"
       ],
       "properties": {
        "text": {
         "type": "string",
         "minLength": 1
        },
        "basis": {
         "type": "string"
        },
        "premortem": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "tripwire": {
         "type": "string"
        }
       }
      }
     },
     "poc": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "text",
        "measure",
        "changes_decision"
       ],
       "properties": {
        "text": {
         "type": "string",
         "minLength": 1
        },
        "measure": {
         "type": "string"
        },
        "threshold_idea": {
         "type": "string"
        },
        "changes_decision": {
         "type": "boolean"
        }
       }
      }
     },
     "human_only": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "text",
        "options"
       ],
       "properties": {
        "text": {
         "type": "string",
         "minLength": 1
        },
        "options": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "option",
           "consequence"
          ],
          "properties": {
           "option": {
            "type": "string"
           },
           "consequence": {
            "type": "string"
           }
          }
         }
        },
        "recommendation": {
         "type": "string"
        }
       }
      }
     }
    }
   },
   "writes": [
    {
     "op": "set",
     "to": "process.decision_details",
     "from": "$"
    },
    {
     "op": "decisions_from_details",
     "from": "$"
    }
   ],
   "outputs": [
    "decisions（decide_now・poc・human_only）"
   ],
   "note": "decisions の 3 配列（文字列）は駆動器が details の text から作る"
  },
  "report": {
   "stage": "最終報告",
   "run_by": "surveyor",
   "deps": [
    "p5.adapt"
   ],
   "pre": "finalize",
   "text": true,
   "source": "成果物の型／最終報告",
   "prompt_file": "../prompts/research-loop/report.md",
   "reads": [
    "record",
    "validation",
    "raw",
    "inputs.lang",
    "inputs.document",
    "thickness"
   ],
   "outputs": [
    "final_report"
   ],
   "note": "駆動器が先に記録を仕上げて検証器を回す。exit 0 でなければこの節は出ない",
   "save_text_as": "report.md"
  },
  "reflect": {
   "stage": "ループの後",
   "run_by": "surveyor",
   "deps": [
    "report"
   ],
   "source": "型への還流",
   "prompt_file": "../prompts/research-loop/reflect.md",
   "reads": [
    "record.process",
    "record.convergence"
   ],
   "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "notes",
     "proposed_changes"
    ],
    "properties": {
     "notes": {
      "type": "string",
      "minLength": 1
     },
     "proposed_changes": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "target",
        "text"
       ],
       "properties": {
        "target": {
         "type": "string",
         "enum": [
          "graph",
          "prompt",
          "driver",
          "validator",
          "none"
         ]
        },
        "text": {
         "type": "string"
        }
       }
      }
     }
    }
   },
   "writes": [
    {
     "op": "set",
     "to": "process.reflect",
     "from": "$"
    }
   ],
   "outputs": [
    "skill_diff（任意）"
   ]
  }
 },
 "rules": "../rules/research-loop.py",
 "tree_guard_roles": [
  "investigator"
 ],
 "raw_for_report": [
  "p1.refuter",
  "p3.rederiver",
  "p3.rederiver_compare",
  "p3.cartographer_compare",
  "p3.cold_reader",
  "p3.sampling",
  "p0.independence_review"
 ],
 "cond_note": "cond の path は engine が解決する。解決できない path は die——綴り違いや欄の改名が「条件が成り立たない」に化けると、走らなかった節の素材に事実と逆の理由が書かれたまま収束まで通る。設計上まだ書かれていない欄を見る cond は default を明示する（下の各節）",
 "verdict_paths": [
  "gates",
  "sampling",
  "convergence",
  "decisions"
 ],
 "verdict_fields": [
  "verdict",
  "refuted",
  "upheld"
 ],
 "verdict_note": "回す側（runners）が書いてはいけない記録の場所と欄名。graphcheck が節の outputs と writes をこれで照合する（判定の語彙は loop ごとに違うので engine にも検査器にも写さない）"
}