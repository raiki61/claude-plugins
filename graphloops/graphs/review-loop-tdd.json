{
 "extends": "review-loop.json",
 "rules": "../rules/review-loop-tdd.py",
 "inputs": {
  "tdd_suite": {
   "kind": "file",
   "note": "テスト一式を走らせる実行ファイル。JUnit XML の書き先を第 1 引数に受け、リポジトリのルートで走る（init --input tdd_suite=<パス>）。無ければ init が止まる"
  }
 },
 "hist_schema": {
  "properties": {
   "tdd_gave_up": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "round": {
       "type": "integer"
      },
      "step": {
       "type": "string"
      },
      "problems": {
       "type": "array"
      }
     }
    },
    "description": "TDD を諦めた周・段・理由（各周の p3.tdd_red・p3.tdd_green の出力の gave_up）"
   },
   "tdd_retry": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "red": {
      "type": "object",
      "properties": {
       "ok": {
        "type": "boolean"
       },
       "problems": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "tries": {
        "type": "integer"
       }
      }
     },
     "green": {
      "type": "object",
      "properties": {
       "ok": {
        "type": "boolean"
       },
       "problems": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "tries": {
        "type": "integer"
       }
      }
     }
    },
    "description": "この周の赤・緑の確認の最後の試行（p3.tdd_red・p3.tdd_green の出力の ok・problems・tries）"
   }
  }
 },
 "overview": "review-loop（graphs/review-loop.json の overview）と同じループで、P3 の修正だけを TDD の流れに差し替えた版。修正を 2 段に割る: 直す単位ごとに、使う側の呼び口で今は落ちるテストだけを書き（書きにくさ——準備が重い・内部に手を入れる・名前から意図が読めない——を単位ごとに記録する）、engine が一式を回して名指しのテストが狙いどおりの失敗で赤・ほかは緑であることを確かめ（赤の確認）、同じ writer が実装してテストを通し、engine が名指しもほかも緑で、テストのファイルを書き換えていないことを確かめる（緑の確認）。先にテストを書けない単位（文書・指示書・注記だけの直し）は理由をつけて今の修正の流れに回す。テスト一式のコマンドは init --input tdd_suite='…{junit}…' で渡す（JUnit XML を書く物）。TDD を使った周ごとに、修正差分への変異の見逃しの本数と、その周の修正が作った指摘の件数を record.process.tdd に残す",
 "blocks": {
  "fix": {
   "$ref": "../blocks/review-loop/fix-tdd/block.json"
  }
 },
 "nodes": {
  "p3.tdd_start": {
   "stage": "P3",
   "run_by": "driver",
   "builtin": "tdd_start",
   "deps": [
    "p2.history",
    "p2.plan_review",
    "p3.lane_merge",
    "p2.human_gate"
   ],
   "cond": "units_open",
   "source": "P3（TDD）＞ テストを書く前の版を固める",
   "does": "テストだけを書く段が触ったファイルをこの版からの差で測るために作業ツリーの今の姿を版に固め、テスト一式を 1 回走らせて元の結末を取る（『ほかは緑のまま』は元の結末で通っていたテストに当てる。元から落ちていたテストは問わない）",
   "outputs": [
    "out.p3.tdd_start（rev・baseline・baseline_exit・suite_made）"
   ],
   "reads": [],
   "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "problems": {
      "$ref": "engine#/driver_problems"
     },
     "rev": {
      "type": "string"
     },
     "cases": {
      "type": "integer"
     },
     "red_before": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "baseline": {
      "type": "object",
      "patternProperties": {
       "^": {
        "type": "string"
       }
      },
      "description": "元の結末（テストの識別子 → 結末）"
     },
     "baseline_exit": {
      "type": [
       "integer",
       "null"
      ]
     },
     "suite_made": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "一式を走らせたことで作業ツリーに出来た・変わったファイル（前の試行の出力から累積）"
     }
    }
   }
  },
  "p3.tdd_tests": {
   "stage": "P3",
   "run_by": "writer",
   "deps": [
    "p3.tdd_start",
    "p2.fix_units"
   ],
   "cond": "units_open",
   "source": "P3（TDD）＞ テストだけを書く",
   "does": "直す単位ごとに、使う側の呼び口で今は落ちるテストだけを書き、名指しする。書きにくさを単位ごとに記録する。先にテストを書けない単位は理由をつけて今の修正の流れ（direct）に回す。実装のファイルには触れない",
   "outputs": [
    "out.p3.tdd_tests"
   ],
   "prompt_file": "../prompts/review-loop/tdd/p3.tdd_tests.md",
   "reads": [
    "loop.fix_units",
    "record.questions",
    "record.process.diagnosis",
    "out.p2.plan_review",
    "inputs.cwd",
    "inputs.tdd_suite",
    "cur.p3.tdd_start",
    "hist.tdd_retry"
   ],
   "post_check": "tdd_tests_output",
   "pointers": [
    {
     "at": "units[].unit_key",
     "from": [
      "loop.fix_units.rows"
     ]
    }
   ],
   "schema": {
    "$ref": "../blocks/review-loop/fix-tdd/exit.schema.json#/properties/p3.tdd_tests"
   }
  },
  "p3.tdd_red": {
   "stage": "P3",
   "run_by": "driver",
   "builtin": "tdd_red",
   "deps": [
    "p3.tdd_tests"
   ],
   "cond": "tdd_named",
   "source": "P3（TDD）＞ 赤の確認（機械）",
   "does": "テスト一式を 1 回走らせ、JUnit XML で、名指しのテストが全部 failure で落ち（error・一式に居ない・もう通る・飛ばされたは失格）、元の結末で通っていたテストとこの周に足した名指しの外のテストは通ることを確かめる。テストだけを書く段が申告したテストのファイルの外に触れていないことも確かめる。通らなければテストだけを書く段を差し戻す。3 回通らなければ TDD を諦めて今の流れで進め、理由を記録と次の周の判定役に渡す",
   "outputs": [
    "out.p3.tdd_red（red_rev・named_tests・problems・tries・suite_made）"
   ],
   "reads": [],
   "schema": {
    "$ref": "../blocks/review-loop/fix-tdd/exit.schema.json#/properties/p3.tdd_red"
   }
  },
  "p3.fix": {
   "deps": [
    "p2.history",
    "p2.plan_review",
    "p3.lane_merge",
    "p3.tdd_red",
    "p2.human_gate",
    "p2.fix_units"
   ],
   "reads": [
    "loop.fix_units",
    "record.questions",
    "record.process.diagnosis",
    "inputs.review_md",
    "inputs.cwd",
    "record.base",
    "prev.r1.minimality",
    "prev.r4.hidden_scope",
    "out.p2.plan_review",
    "cur.p3.lane_merge",
    "out.p3.tdd_tests",
    "cur.p3.tdd_red",
    "hist.tdd_retry",
    "record.process.policy.path",
    "record.process.human_items"
   ],
   "prompt_append": [
    "../prompts/review-loop/tdd/p3.fix.md",
    "../prompts/policy-path.md",
    "../prompts/policy.md"
   ]
  },
  "p3.tdd_green": {
   "stage": "P3",
   "run_by": "driver",
   "builtin": "tdd_green",
   "deps": [
    "p3.fix"
   ],
   "cond": "tdd_red_passed",
   "source": "P3（TDD）＞ 緑の確認（機械）",
   "does": "テスト一式を 1 回走らせ、名指しのテストと、元の結末で通っていたテストが全部通り（元の一式が 0 で終わっていたなら一式も 0 で終わる）、実装の段が申告したテストのファイルを赤の確認の版から書き換えていないことを確かめる。通らなければ実装（p3.fix）を差し戻す。3 回通らなければ諦めて進め、理由を記録と次の周の判定役に渡す",
   "outputs": [
    "out.p3.tdd_green（problems・tries・suite_made）"
   ],
   "reads": [],
   "schema": {
    "$ref": "../blocks/review-loop/fix-tdd/exit.schema.json#/properties/p3.tdd_green"
   }
  },
  "p3.fix_delta": {
   "deps": [
    "p3.fix",
    "p3.tdd_green"
   ]
  },
  "p3.delta_review": {
   "reads": [
    "cur.p3.fix_delta.delta.file",
    "cur.p3.fix_delta.delta.files",
    "inputs.cwd",
    "out.p2.plan_review",
    "cur.p3.fix_delta.delta.claimed",
    "out.p3.tdd_tests",
    "record.process.policy.path"
   ],
   "prompt_append": [
    "../prompts/review-loop/tdd/p3.delta_review.md",
    "../prompts/policy-paste.md",
    "../prompts/policy.md"
   ]
  }
 },
 "launch": {
  "runner": {
   "edits": [
    "p3.fix",
    "p3.delta_fix",
    "p3.delta_fix2",
    "spec.write",
    "spec.revise",
    "p3.tdd_tests"
   ]
  }
 },
 "$defs": {}
}
