#!/bin/sh
''':'
# ここから閉じの引用符 3 つまでは sh が読む（Python には 1 つの文字列）。python3・python・版の付いた名前（python3.20 から python3.11 まで、
# 新しい順。uv で入れた Python はその名前でだけ PATH に在る。docs/standards/cross-os.md の決まり 1）・py -3 の順に、実際に起きる 3.11 以上の物で
# この台本を起動し直す（上書きを TOML として確かめる tomllib が 3.11 から）。PATH の頭の python3 をそのまま使わないのは、Windows の python3・python が、Python を入れていないと
# Microsoft Store へ誘う代わりの物（起動すると案内を出して終わる）に当たるため。
named='' n=20
while [ "$n" -ge 11 ]; do named="$named python3.$n"; n=$((n - 1)); done
# shellcheck disable=SC2086
for cand in python3 python $named "py -3"; do
  command -v "${cand%% *}" >/dev/null 2>&1 || continue
  # shellcheck disable=SC2086
  $cand -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1 && exec $cand "$0" "$@"
done
echo "tiers-statusline: 起動できる Python 3.11 以上が見つからない（python3・python・python3.20〜python3.11・py -3 を試した）。Python 3.11 以上を入れる。入れてあるのに見つからないなら、入れた場所を PATH に足す。Windows で python3 や python が Microsoft Store へ誘うなら、設定 → アプリ → アプリ実行エイリアス で python.exe と python3.exe の「アプリ インストーラー」を切る" >&2
exit 1
'''
"""statusline と herdr の判定ルールの上書きを入れて保つ道具の入口。中身は ../lib/tiers_statusline.py（使い方もそこ）。

Claude Code は、有効なプラグインのルートの bin/ を Bash のツールの PATH に入れる。依存として入ったプラグインの bin/ も入る
（2026-10-16 に Claude Code 2.1.301 で試した。tiers/README.md の「置き場」）。
"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))
import tiers_statusline  # noqa: E402

if __name__ == "__main__":
    for _s in (sys.stdout, sys.stderr):
        if hasattr(_s, "reconfigure"):
            _s.reconfigure(encoding="utf-8")
    sys.exit(tiers_statusline.main())
