#!/bin/sh
''':'
# ここから閉じの引用符 3 つまでは sh が読む（Python には 1 つの文字列）。python3・python・py -3 の順に、実際に起きる 3.8 以上の物で
# この台本を起動し直す（2026-10-26 に 3.8 で動くのを確かめた。python が Python 2 の PC では、版を見ないと 2 で起動して構文の誤りで落ちる）。PATH の頭の python3 をそのまま使わないのは、Windows の python3・python が、Python を入れていないと
# Microsoft Store へ誘う代わりの物（起動すると案内を出して終わる）に当たるため。
for cand in python3 python "py -3"; do
  command -v "${cand%% *}" >/dev/null 2>&1 || continue
  # shellcheck disable=SC2086
  $cand -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1 && exec $cand "$0" "$@"
done
echo "tiers: 起動できる Python 3.8 以上が見つからない（python3・python・py -3 を試した）。Python 3.8 以上を入れる。Windows で python3 や python が Microsoft Store へ誘うなら、設定 → アプリ → アプリ実行エイリアス で python.exe と python3.exe の「アプリ インストーラー」を切る" >&2
exit 1
'''
"""要るツールの段ごとの点検の入口。中身は ../lib/tiers_check.py（使い方もそこ）。

Claude Code は、有効なプラグインのルートの bin/ を Bash のツールの PATH に入れる。依存として入ったプラグインの bin/ も入る
（2026-10-16 に Claude Code 2.1.301 で試した。tiers/README.md の「置き場」）。
"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))
import tiers_check  # noqa: E402

if __name__ == "__main__":
    for _s in (sys.stdout, sys.stderr):
        if hasattr(_s, "reconfigure"):
            _s.reconfigure(encoding="utf-8")
    sys.exit(tiers_check.main())
