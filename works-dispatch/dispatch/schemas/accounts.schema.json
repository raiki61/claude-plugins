{
  "type": "object",
  "required": ["schema", "accounts"],
  "properties": {
    "schema": {"type": "integer", "enum": [1]},
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command", "config_dir", "seven_day", "five_hour", "known", "eligible", "reason", "score", "peak", "running"],
        "properties": {
          "name": {"type": "string"},
          "command": {"type": "string"},
          "config_dir": {"type": ["string", "null"]},
          "seven_day": {"type": "object", "required": ["used", "resets_at"],
                        "properties": {"used": {"type": ["number", "null"]}, "resets_at": {"type": ["integer", "null"]}}},
          "five_hour": {"type": "object", "required": ["used", "resets_at"],
                        "properties": {"used": {"type": ["number", "null"]}, "resets_at": {"type": ["integer", "null"]}}},
          "known": {"type": "boolean"},
          "stale": {"type": "boolean"},
          "hours": {"type": ["string", "null"]},
          "shut": {"type": "boolean"},
          "eligible": {"type": "boolean"},
          "reason": {"type": ["string", "null"]},
          "eligible_at": {"type": ["integer", "null"]},
          "score": {"type": ["number", "null"], "minimum": 0},
          "peak": {"type": ["number", "null"]},
          "named_only": {"type": "boolean"},
          "named_ok": {"type": "boolean"},
          "running": {"type": "integer"}
        }
      }
    },
    "pick": {"type": ["object", "null"], "required": ["name", "command", "config_dir", "why"],
             "properties": {"name": {"type": "string"}, "command": {"type": "string"},
                            "config_dir": {"type": ["string", "null"]}, "why": {"type": "string"}}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
