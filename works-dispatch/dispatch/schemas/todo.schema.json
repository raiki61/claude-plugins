{
  "type": "object",
  "required": ["schema", "inboxes", "notes", "forest"],
  "properties": {
    "schema": {"type": "integer", "enum": [1]},
    "inboxes": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "reminders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "holder", "on", "after", "created", "reminded", "closed", "due"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "holder": {"type": ["string", "null"]},
          "on": {"type": ["number", "null"]},
          "after": {"type": "array", "items": {"type": "string"}},
          "created": {"type": ["number", "null"]},
          "reminded": {"type": ["number", "null"]},
          "closed": {"type": ["number", "null"]},
          "due": {"type": ["string", "null"]}
        }
      }
    },
    "held_by": {"type": "array", "items": {"type": "string"}},
    "summary": {
      "type": "object",
      "required": ["counts", "total", "done_ratio", "oldest_open", "filter"],
      "properties": {
        "counts": {
          "type": "object",
          "required": ["queued", "working", "waiting", "done", "dropped", "failed"],
          "properties": {
            "queued": {"type": "integer"}, "working": {"type": "integer"}, "waiting": {"type": "integer"},
            "done": {"type": "integer"}, "dropped": {"type": "integer"}, "failed": {"type": "integer"}
          }
        },
        "total": {"type": "integer"},
        "done_ratio": {"type": ["number", "null"]},
        "oldest_open": {
          "type": ["object", "null"],
          "required": ["id", "updated", "age"],
          "properties": {"id": {"type": "string"}, "updated": {"type": ["number", "null"]}, "age": {"type": "number"}}
        },
        "filter": {
          "type": ["object", "null"],
          "required": ["states", "to"],
          "properties": {
            "states": {"type": "array", "items": {"type": "string", "enum": ["queued", "working", "waiting", "done", "dropped", "failed"]}},
            "to": {"type": ["string", "null"]}
          }
        }
      }
    },
    "forest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task", "kids", "follows", "reminders"],
        "properties": {
          "kids": {"type": "array"},
          "follows": {"type": "array", "items": {"type": "string"}},
          "reminders": {"type": "array", "items": {"type": "object",
                                                   "required": ["id", "text", "holder", "on", "after", "created", "reminded", "closed"]}},
          "task": {
            "type": "object",
            "required": ["id", "title", "state", "label", "progress", "open", "created", "updated", "parent", "parent_by",
                         "children", "follows", "reminders", "questions", "notes", "from", "to", "file", "why"],
            "properties": {
              "id": {"type": "string"},
              "title": {"type": ["string", "null"]},
              "state": {"type": "string", "enum": ["queued", "working", "waiting", "done", "dropped", "failed"]},
              "label": {"type": "string"},
              "progress": {"type": "string", "enum": ["needs-action", "in-process", "completed", "failed", "cancelled"]},
              "open": {"type": "boolean"},
              "created": {"type": ["number", "null"]},
              "updated": {"type": ["number", "null"]},
              "closed": {"type": ["number", "null"]},
              "parent": {"type": ["string", "null"]},
              "parent_by": {"type": ["string", "null"], "enum": ["forwarded", "cause", "inferred", null]},
              "children": {"type": "array", "items": {"type": "string"}},
              "follows": {"type": "array", "items": {"type": "string"}},
              "reminders": {"type": "array", "items": {"type": "string"}},
              "questions": {
                "type": "array",
                "items": {"type": "object", "required": ["holder", "ask"],
                          "properties": {"holder": {"type": ["string", "null"]}, "ask": {"type": ["string", "null"]}}}
              },
              "notes": {"type": "integer"},
              "forwarded": {"type": "boolean"},
              "from": {"type": ["string", "null"]},
              "to": {"type": "object"},
              "file": {"type": ["string", "null"]},
              "why": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
