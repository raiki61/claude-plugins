  {"name": "design.json", "format": "json", "schema": "schemas/design.schema.json", "at": "root"},
  {"name": "gate-marks.json", "format": "json", "schema": "schemas/gate-marks.schema.json", "at": "root"},
  {"name": "plan-fields.json", "format": "json", "schema": "schemas/plan-fields.schema.json", "at": "root"},
  {"name": "plan-converge.json", "format": "json", "schema": "schemas/plan-converge.schema.json"},
  {"name": "plan-converge/**", "format": "md"},
  {"name": "replan.json", "format": "json", "schema": "schemas/replan.schema.json"},
  {"name": "rejects-r2.design.json", "format": "json", "schema": "../.shared/core/rejects.schema.json", "at": "root"},
  {"name": "rejects-replan.fix_plan.json", "format": "json", "schema": "../.shared/core/rejects.schema.json", "at": "root"},
