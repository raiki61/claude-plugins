  {"name": "reads-*.json", "format": "json", "schema": "../.shared/core/reads.schema.json", "per_include": true},
  {"name": "reads-plan-block.json", "format": "json", "schema": "schemas/reads-index.schema.json", "per_include": true},
  {"name": "reads-replan-block.json", "format": "json", "schema": "schemas/reads-index.schema.json", "per_include": true}
 ]
}
