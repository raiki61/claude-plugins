{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "修正の後の局所レビューの控え r<N>/lens.json（書き手は core の lens。振り分けが書き、集め役が埋める）",
 "type": "object",
 "required": ["rows"],
 "properties": {
  "rows": {"type": "array", "items": {
   "type": "object",
   "required": ["lens", "state"],
   "properties": {
    "lens": {"type": "string"},
    "agent": {"type": "string"},
    "go": {"type": "boolean"},
    "reason": {"type": "string"},
    "state": {"type": "string", "enum": ["pending", "ran", "failed", "not_routed"]},
    "findings": {"type": "array", "items": {"type": "object", "properties": {"lens": {"type": "string"}, "where": {"type": "string"}, "cite": {"type": "string"}, "why": {"type": "string"}}}}
   }
  }}
 }
}
