{
 "terms": [
  {"term": "取り込みの前", "definition": "PR を既定の枝へ merge する前（人が PR の CI の結果を見て merge を決める時点）"},
  {"term": "関所", "definition": "run の途中で、先へ進めるかを人か機械が決める所"},
  {"term": "盤面", "definition": "run の状態（周・節・出力・記録）を持つ作業の置き場"},
  {"term": "問いの台帳", "definition": "判定の役が人に聞くと決めた問いの一覧（記録の questions）"},
  {"term": "根本の単位", "definition": "判定の役が指摘を根ごとにまとめた、直す単位（記録の units）"},
  {"term": "初見検査", "definition": "道具も文脈も持たない読み手が、報告の頭だけを読んで意味が取れるかを確かめる検査"},
  {"term": "初見の確かめ", "definition": "書き手の報告の頭を、道具も文脈も持たない読み手に読ませて意味が取れるかを確かめること"},
  {"term": "検証器", "definition": "記録（record.json）が決まりに合うかを機械で確かめるプログラム"},
  {"term": "独立の目", "definition": "修正に関わっていない役が差分を別に見て出す判定"},
  {"term": "裁定役", "definition": "修正役が申し出た食い違いを持ち主の決まりで裁く、読むだけの役"},
  {"term": "閉鎖の数え直し", "definition": "直した後に、判定の問いで同じ形がまだ残るかを機械で数え直すこと"},
  {"term": "差分の審査", "definition": "修正の差分を役が読んで確かめる審査"},
  {"term": "周", "definition": "判定→修正→確かめの一巡。周ごとに番号が付く"},
  {"term": "ライン", "definition": "works の工程の組み（例: darkfactory）。どの節を誰が受け持つかを決める"},
  {"term": "節", "definition": "盤面の工程の 1 つ（graph の node）"},
  {"term": "本線", "definition": "works が写しを持つ元の実装（graphloops）"},
  {"term": "初見の読み手", "definition": "道具も文脈も持たずに報告の頭だけを読み、意味が取れるかを返す役"},
  {"term": "守りのファイル", "definition": "works 自身の試験・柵・受け付けの口のファイル（一覧に載る物）。修正が触ると最後の関所で人が確かめる"},
  {"term": "食い違いの申し出", "definition": "修正の役が、テスト・依頼・コードのうち 2 つが同時には成り立たないと返した単位"},
  {"term": "阻害", "definition": "独立の目の判定のうち、そのままでは先へ進めないとする物"},
  {"term": "独立の設計と比べる目", "definition": "修正と別に設計を作り、それと修正の差分を比べる独立の目（R2）"},
  {"term": "独立設計", "definition": "修正の計画を見ずに、目的と制約だけから別の AI が作る設計（独立の設計と比べる目が差分と比べる相手）"}
 ],
