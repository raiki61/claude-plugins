#!/usr/bin/env python3
"""試験の偽の claude（tests/test_adapter.py）。本物の AI を起こさない。

受けた argv・標準入力・cwd・環境（WORKS_* と CLAUDE_* と PATH）を $FAKE_CLAUDE_LOG に JSON の 1 行で足し、
標準入力をそのまま標準出力へ写し、$FAKE_CLAUDE_EXIT（既定 0）で終わる。

$FAKE_CLAUDE_GRANDCHILD（pid を書くファイル）を渡すと、本物の claude の Bash の道具と同じ形で孫を起こす
（試し P15。scratchpad/probes-p14-p15-summary.md）:
- 孫は新しいセッション（＝別のプロセスグループ）で走る `bash -c "trap '' INT TERM HUP; sleep 600"`（SIGTERM を無視する）
- SIGTERM・SIGINT を受けたら孫へ SIGTERM だけを送って即抜ける（143・130。SIGKILL へは上げない）
- $FAKE_CLAUDE_STAY=1 なら信号まで待つ。無ければ 1 秒待って（包みが見回る間）孫を残したまま普通に終わる
$FAKE_CLAUDE_ORPHAN=1 を足すと、孫は中継ぎの子から setpgid で別のグループ（セッションは claude のまま）に出て、
中継ぎはすぐ抜ける（見回りの間に孤児になる孫。SIGTERM・SIGINT・SIGHUP を無視する）
$FAKE_CLAUDE_READ（ファイルのパス）を渡すと、標準入力を読み終えた時のそのファイルの中身を記録の read に書く（無ければ null。
包みが指示書に全文版か差分版を書いてから指示文を渡したかを見る）
"""
import json
import os
import signal
import subprocess
import sys
import time

data = sys.stdin.read()
row = {
    "argv0": sys.argv[0],
    "argv": sys.argv[1:],
    "stdin": data,
    "cwd": os.getcwd(),
    "pid": os.getpid(),
    "env": {k: v for k, v in os.environ.items() if k.startswith(("WORKS_", "CLAUDE_")) or k == "PATH"},
}
if os.environ.get("FAKE_CLAUDE_READ"):
    try:
        with open(os.environ["FAKE_CLAUDE_READ"], encoding="utf-8") as f:
            row["read"] = f.read()
    except OSError:
        row["read"] = None
with open(os.environ["FAKE_CLAUDE_LOG"], "a", encoding="utf-8") as f:
    f.write(json.dumps(row, ensure_ascii=False) + "\n")

pidfile = os.environ.get("FAKE_CLAUDE_GRANDCHILD")
if pidfile and os.environ.get("FAKE_CLAUDE_ORPHAN") == "1":
    # 中継ぎの子が、setpgid で別のグループ（セッションは claude のまま）に出た孫を起こしてすぐ抜ける。
    # 孫は親 1 の孤児になる。包みの見回り（0.2 秒ごと）より先に起きるので、親子の鎖では拾えない
    mid = os.fork()
    if mid == 0:
        kid = os.fork()
        if kid == 0:
            os.setpgid(0, 0)
            for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
                signal.signal(sig, signal.SIG_IGN)
            os.execvp("sleep", ["sleep", "600"])
        with open(pidfile + ".tmp", "w", encoding="utf-8") as f:
            f.write(f"{kid}\n")
        os.replace(pidfile + ".tmp", pidfile)
        os._exit(0)
    os.waitpid(mid, 0)
    time.sleep(0.5)   # claude はまだ走る（包みの見回りが回る。孫は既に孤児）
elif pidfile:
    child = subprocess.Popen(["bash", "-c", "trap '' INT TERM HUP; sleep 600"], start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def leave(code):
        def handler(_signum, _frame):
            os.kill(child.pid, signal.SIGTERM)
            os._exit(code)
        return handler

    signal.signal(signal.SIGTERM, leave(143))
    signal.signal(signal.SIGINT, leave(130))
    with open(pidfile + ".tmp", "w", encoding="utf-8") as f:
        f.write(f"{child.pid}\n")
    os.replace(pidfile + ".tmp", pidfile)
    if os.environ.get("FAKE_CLAUDE_STAY") == "1":
        while True:
            time.sleep(1)
    time.sleep(1)

sys.stdout.write(data)
sys.stdout.flush()
sys.exit(int(os.environ.get("FAKE_CLAUDE_EXIT", "0")))
