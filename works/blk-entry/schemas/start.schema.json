{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "始めの記録 r1/start.json（書き手は入口のブロックの open＝core の entry.start と固定材料の取り込み）。置き場の名と読む口は core の startrec。入口の入力の形は欄 input、ほかは run の入力の控えと start の結果",
 "type": "object",
 "required": [
  "run_id",
  "base_rev",
  "test_cmd",
  "adapter",
  "final_gate",
  "thickness"
 ],
 "properties": {
  "run_id": {
   "type": "string",
   "minLength": 1
  },
  "input": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "base",
    "head_rev",
    "diff",
    "requests",
    "request_file",
    "pr",
    "spec"
   ],
   "properties": {
    "base": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "rev",
      "from",
      "name",
      "label"
     ],
     "description": "差分の根（P1 の役が差分を取る起点の版）。from は head（名指しなし）・base（--base）・pr（PR の base との merge-base）、label は頭の行に書く出どころの文",
     "properties": {
      "rev": {
       "type": "string",
       "pattern": "^[0-9a-f]{40}$"
      },
      "from": {
       "type": "string",
       "enum": [
        "head",
        "base",
        "pr"
       ]
      },
      "name": {
       "type": "string"
      },
      "label": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "head_rev": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$",
     "description": "start の時の HEAD（修正の起点）"
    },
    "diff": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "empty",
      "files",
      "stat"
     ],
     "description": "差分の根から作業ツリーの今の姿（未追跡も含む・.gitignore の物は除く）までの測り。start の 1 回で固め、呼び直しでは測り直さない",
     "properties": {
      "empty": {
       "type": "boolean"
      },
      "files": {
       "type": "integer",
       "minimum": 0
      },
      "stat": {
       "type": "string"
      }
     }
    },
    "requests": {
     "type": "integer",
     "minimum": 0,
     "description": "依頼の行の数（行そのものは盤面の record.process.request_findings）"
    },
    "request_file": {
     "type": "string",
     "description": "依頼のファイルの絶対パス（無ければ空）"
    },
    "pr": {
     "type": [
      "object",
      "null"
     ],
     "additionalProperties": false,
     "required": [
      "number",
      "title"
     ],
     "description": "PR の添え物（番号と題。本文は盤面の依頼の文と github.json に在る）。PR でなければ null",
     "properties": {
      "number": {
       "type": "string",
       "pattern": "^[0-9]+$"
      },
      "title": {
       "type": "string"
      }
     }
    },
    "spec": {
     "type": "boolean",
     "description": "仕様の段を挟むか（入力 spec）"
    }
   },
   "description": "入口の入力の形（input.schema.json と同じ形。試験 test_entry_block が縛る）。前の版の固定材料から取り込んだ控えには無い"
  },
  "base_rev": {
   "type": "string",
   "description": "修正の起点（修正前の HEAD）"
  },
  "requests": {
   "type": "integer",
   "minimum": 0
  },
  "request_file": {
   "type": "string"
  },
  "test_cmd": {
   "type": "string"
  },
  "thickness": {
   "type": "string"
  },
  "gates": {
   "type": "string"
  },
  "final_gate": {
   "type": "string",
   "enum": [
    "always",
    "when_needed",
    "protected_only"
   ]
  },
  "adapter": {
   "type": "string",
   "enum": [
    "",
    "optional"
   ]
  },
  "policy_md": {
   "type": "string"
  },
  "lang": {
   "type": "string"
  },
  "unattended": {
   "type": "string"
  },
  "design_only": {
   "type": "string"
  },
  "fix_fixture": {
   "type": "string"
  },
  "launch_mark": {
   "type": "string",
   "description": "起こす殻が起動ごとに付けた印（生の事実）"
  },
  "features_off": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "features_on": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "features_cut": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "answers": {
   "type": "array"
  },
  "ci_fallback": {
   "type": "string",
   "enum": [
    "test_cmd",
    "role"
   ]
  },
  "ci_role_go": {
   "type": "boolean"
  },
  "head_line": {
   "type": "string"
  }
 }
}
