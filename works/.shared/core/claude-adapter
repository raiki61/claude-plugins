#!/usr/bin/env python3
# /// script
# requires-python = ">=3.9"
# dependencies = []
# ///
"""works の Claude の包み。Archon の claudeBinaryPath（設定）か CLAUDE_BIN_PATH（env）にこのファイルを置く。

SDK が組んだ argv に Read のフック・会話の継ぎ・起動ごとの柵（切符が在る時）を足して、本物の claude を子として起こし、
止める時は Bash の道具の孫まで木ごと止める（何を・なぜは adapter.py の頭）。
- 本物の claude: env の WORKS_REAL_CLAUDE（絶対パス）、無ければ PATH の実行ファイル `claude`（この包み自身は飛ばす）。
  見つからなければ 1 行を出して終了コード 127
- 置き場: env の WORKS_ADAPTER_HOME（無ければ ${XDG_STATE_HOME:-~/.local/state}/works/adapter）。絶対パスでなければ 1 行を出して終了コード 2
- 印のある起動で、continue=X の X の id が無い・印が読めない・--settings を混ぜられない・切符が読めない・盤面の修正の形の
  控えが読めない・会話の id を記録できない時は、子を起こさずに 1 行を出して終了コード 3（fail closed）
- 印のある起動は stdin を中継し、最初の指示文で指示書の全文版か差分版を決めてから子へ渡す（adapter.py の頭の 9）
- stream-json の起動は stdout を同じバイトで写し（印のある起動の result の費用の累計だけ、Archon の引き算がその起動の費用に
  なる値に見せ直す。頭の 20）、1 手も進まずに終わった子は result を写さずに終了コード 75
  （adapter.NO_TURN_EXIT。Archon が transient として起こし直す）。result の全文は exits/<cwd の hash>.jsonl に残す（頭の 16）
- 印に旗 text-reply を持つ起動は、子に schema を渡さず（argv と initialize の両方）、result の本文を schema で確かめ、合わなければ
  result を写さずに同じ子へ理由の行を足して出し直させ、合えば structured_output を置いて写す。回ごとの決めは
  replies/<cwd の hash>.jsonl に残す（頭の 21・replycontract.py）
- 名前を .js で終わらせない（Archon は .js の実行ファイルを bun で起こして --no-env-file を足す）
uv を通さない（Archon が直に起こす）。標準ライブラリだけ。
"""
import json
import os
import sys
import threading

sys.dont_write_bytecode = True   # 下の import が pack の中に __pycache__ を作らないように。必ず import より前
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)

import adapter  # noqa: E402

SELF = os.path.realpath(__file__)
RECORDER = os.path.join(HERE, "record-read.py")
WRITE_RECORDER = os.path.join(HERE, "record-write.py")


def say(line):
    sys.stderr.write("works claude-adapter: " + line + "\n")
    sys.stderr.flush()


def real_claude():
    """本物の claude の絶対パス。包み自身に解けるものは使わない"""
    want = os.environ.get(adapter.ENV_REAL)
    if want:
        cands = [want]
    else:
        cands = [os.path.join(d, "claude") for d in os.environ.get("PATH", "").split(os.pathsep) if d]
    for c in cands:
        if os.path.isabs(c) and os.path.isfile(c) and os.access(c, os.X_OK) and os.path.realpath(c) != SELF:
            return c
    return None


def log_launch(home_dir, cwd, p):
    write_row(home_dir, cwd, adapter.launch_row(p, cwd, os.getpid(), adapter.now()))


def append_row(path, row, what):
    try:
        os.makedirs(str(path.parent), mode=0o700, exist_ok=True)
        with open(str(path), "a", encoding="utf-8") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
    except OSError as e:
        say(f"{what}を書けない（{path}: {e}）")


def write_row(home_dir, cwd, row):
    append_row(adapter.launches_path(cwd, home_dir), row, "起動の記録")


def write_exit(home_dir, cwd, row):
    append_row(adapter.exits_path(cwd, home_dir), row, "子の終わりの記録")


def run(home_dir, cwd, real, p, on_line=None):
    """本物の claude を起こして待つ（adapter.supervise）。1 手も進まずに終わった子（adapter.py の頭の 16）は、写さなかった
    result を終わりの記録に残し、1 行を出して NO_TURN_EXIT で返す"""
    on_result = None
    if p.mode == "merged" and p.spend_from is not None:   # 費用の見せ直し（adapter.py の頭の 20）
        bases = adapter.spend_bases(cwd, home_dir, *p.spend_from)
        on_result = lambda line, doc: adapter.restate_result(line, doc, cwd, home_dir, bases)  # noqa: E731
    reply = None
    if p.mode == "merged" and p.reply is not None:   # 返答の契約（adapter.py の頭の 21）
        def log_reply(row):
            append_row(adapter.replies_path(cwd, home_dir), {"at": adapter.now(), "pid": os.getpid(), "node": p.node, **row},
                       "返答の契約の記録")
        reply = adapter.replycontract.Contract(p.reply, log=log_reply)
    out = adapter.OutWatch(on_result, reply) if adapter.watches_out(p.argv) else None
    rc = adapter.supervise([real] + p.argv, p.env, p.cwd, on_line=on_line, out=out)
    if out is not None and out.held is not None and rc == adapter.NO_TURN_EXIT:
        row = adapter.exit_row(p.node, os.getpid(), rc, out.held)
        write_exit(home_dir, cwd, row)
        say(f"子が 1 手も進まずに終わった（節 {p.node or '—'}・{row['subtype']}・is_error {row['is_error']}: {row['head']}）。"
            f"result を写さず、起こし直しを Archon に任せる（終了コード {rc}。全文は {adapter.exits_path(cwd, home_dir)}）")
    return rc


def ticket_reader(cwd, home_dir):
    """切符を 1 回だけ読む関数（protected・run_place・board が同じ読みを使う。入口を 2 つにしない）"""
    cache = []
    def read():
        if not cache:
            cache.append(adapter.read_ticket(cwd, home_dir))
        return cache[0]
    return read


def protected(cwd, home_dir, read=None):
    """守る場所。切符が無ければ None（柵を足さない。線の start が切符を書く前の起動・線の外の起動。旗 no-tree-write の
    起動は plan が拒む）。切符のファイルが在るのに読めなければ adapter.BadTicket（plan が起動を拒む）"""
    doc = (read or (lambda: adapter.read_ticket(cwd, home_dir)))()
    if doc is None:
        return None
    try:   # run ごとの置き場の下の単位の worktree は守らない（下請けが書く）。board が壊れた切符の理由は 17 の口が言う
        place = adapter.run_place_of(doc)
    except adapter.BadTicket:
        place = None
    return adapter.protected_now(doc, cwd, os.environ, adapter.live_worktrees(cwd, place))


def write_id(path, sid):
    """一時ファイルから os.replace（読む側が半端な id を見ない）"""
    os.makedirs(str(path.parent), mode=0o700, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(sid + "\n")
    os.replace(tmp, str(path))


def main():
    argv = sys.argv[1:]
    real = real_claude()
    if real is None:
        where = os.environ.get(adapter.ENV_REAL) or "PATH の claude"
        say(f"本物の claude が見つからない（{where}。包み自身は使わない）。{adapter.ENV_REAL} に絶対パスを設定する")
        return 127
    cwd = os.getcwd()
    home_dir = adapter.home()
    if not home_dir.is_absolute():
        # 相対だと cwd（役が書ける worktree）の下に会話の id と読んだ記録を置いてしまう
        say(f"{adapter.ENV_HOME} が絶対パスでない（{home_dir}）。役の sandbox から書けない場所の絶対パスを設定する")
        return 2
    sink = adapter.reads_dir(cwd, home_dir)
    read = ticket_reader(cwd, home_dir)
    p = adapter.plan(argv, cwd, home_dir, adapter.hook_command(sys.executable, RECORDER, sink),
                     protected=lambda: protected(cwd, home_dir, read),
                     run_place=lambda: adapter.run_place_of(read()),
                     board=lambda: adapter.board_of(read()),
                     write_command=adapter.hook_command(sys.executable, WRITE_RECORDER, sink))
    if p.mode == "refused":
        log_launch(home_dir, cwd, p)
        sys.stderr.write(p.why + "\n")
        return 3
    for path, sid in p.record:
        try:
            write_id(path, sid)
        except OSError as e:
            # 記録できない会話で起こすと、続きの節（再審）が前の run・前の起動の古い id を継ぎうる。古い id は消しに行き、
            # 起こさない（fail closed）
            try:
                os.unlink(str(path))
            except OSError:
                pass
            p = p._replace(mode="refused", hook=False, record=[],
                           why=f"works: 節 {p.node} を起こさない: 会話の id を記録できない（{path}: {e}）",
                           session=dict(p.session or {}, mode="refused"))
            log_launch(home_dir, cwd, p)
            sys.stderr.write(p.why + "\n")
            return 3
    if p.hook:
        try:
            os.makedirs(str(sink), mode=0o700, exist_ok=True)
            open(str(adapter.writes_path(cwd, home_dir)), "a", encoding="utf-8").close()
        except OSError as e:
            say(f"読んだ・書いた記録の置き場を作れない（{sink}: {e}）")
    if p.mode != "merged":
        log_launch(home_dir, cwd, p)
        if p.warn:
            say(f"形が見分けられないので素通しする（{p.why}）")
        return run(home_dir, cwd, real, p)
    # 印のある起動: stdin を中継し、最初の user の行（指示文）で指示書の版を決めてから子へ渡す（adapter.py の頭の 9）。
    # 起動の記録は版を決めた時に 1 行で書く（指示文が来ないまま子が終われば、その後に書く）。時刻は起こす前の物
    row = adapter.launch_row(p, cwd, os.getpid(), adapter.now())
    lock, done = threading.Lock(), []

    def flush():
        with lock:
            if not done:
                done.append(True)
                write_row(home_dir, cwd, row)

    def on_line(line):
        text = adapter.user_text(line)
        if text is None:
            return True
        try:
            got = adapter.prompt_variant(text, p.session, cwd, home_dir)
            if got is not None:
                row["prompt"] = got
        finally:
            flush()
        return False

    try:
        return run(home_dir, cwd, real, p, on_line=on_line)
    finally:
        flush()


if __name__ == "__main__":
    sys.exit(main())
